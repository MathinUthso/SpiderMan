GROQ_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_S=12
INTERPRET_BUDGET_S=22
LOG_LEVEL=INFO
PORT=8000
